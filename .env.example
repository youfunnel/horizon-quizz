# =====================================================================
# Variables d'environnement - Quiz Horizon Finance
# ---------------------------------------------------------------------
# Copiez ce fichier en .env.local pour le developpement, et renseignez
# les memes variables dans Vercel (Settings > Environment Variables).
# =====================================================================

# URL /exec du Web App Google Apps Script qui ecrit les leads dans le
# Google Sheet. C'est la variable indispensable a la persistance des
# leads. Si elle est absente, aucun lead n'est enregistre.
# A recopier depuis Apps Script apres chaque nouveau deploiement (une
# nouvelle version peut changer l'URL).
GOOGLE_SHEETS_WEBHOOK_URL=

# (Optionnel) Second webhook Apps Script de secours. Si l'ecriture
# principale echoue, le lead est renvoye ici. Laisser vide si non utilise.
GOOGLE_SHEETS_WEBHOOK_URL_FALLBACK=

# Page de prise de RDV (System.io) pour les boutons de l'audit.
# Un repli en dur existe dans le code, cette variable permet de le surcharger.
NEXT_PUBLIC_BOOKING_URL=

# Identifiant du Pixel Meta pour le suivi publicitaire.
NEXT_PUBLIC_META_PIXEL_ID=
